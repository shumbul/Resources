{
  "ci": {
    "collect": {
      "staticDistDir": "./docs",
      "url": [
        "http://localhost/index.html",
        "http://localhost/dsa-practice-guide.html",
        "http://localhost/about.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/(index|about)\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "total-byte-weight": ["warn", { "maxNumericValue": 600000 }],
            "unused-css-rules": "off",
            "uses-long-cache-ttl": "off",
            "errors-in-console": "off",
            "csp-xss": "off",
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": ".*/dsa-practice-guide\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.75 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "total-byte-weight": ["warn", { "maxNumericValue": 600000 }],
            "unused-css-rules": "off",
            "uses-long-cache-ttl": "off",
            "errors-in-console": "off",
            "csp-xss": "off",
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.4 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
